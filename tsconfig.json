{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./src/*"],
      "@schema/*": ["./src/packages/schema/*"],
      "@widgets/*": ["./src/packages/widgets/*"],
      "@renderer/*": ["./src/packages/renderer/*"],
      "@designer/*": ["./src/packages/designer/*"]
    },
    "noEmit": true
  }
}
